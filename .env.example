# Twitch
TWITCH_CHANNEL=your_channel
TWITCH_USERNAME=your_bot_username
TWITCH_TOKEN=oauth:your_token_here
# Client ID of the app that generated TWITCH_TOKEN (needed for EventSub)
# Include channel:read:redemptions in the token scopes for redemption logs
TWITCH_CLIENT_ID=your_client_id

# Jev endpoint
JEV_ENDPOINT=localhost
JEV_MODEL=tev1:0.8b

# Moderation mode: false = log only, true = delete messages and time out
MODERATION_ENABLED=false

# Send chat messages when something is flagged (e.g. "@nick spam 70%")
CHAT_MESSAGES_ENABLED=false

# OBS danmaku overlay (served on http://127.0.0.1:3000 by default)
# Only messages with no insult/spam/toxicity/link flag are broadcast.
OVERLAY_ENABLED=true
OVERLAY_HOST=127.0.0.1
OVERLAY_PORT=3000
# Maximum characters per danmaku line (longer messages are clipped)
OVERLAY_MAX_CHARS=140

# Channel point redemptions (EventSub): logs who redeemed which reward
REDEMPTIONS_ENABLED=true
# Optional reward name to highlight in the log
REDEMPTIONS_HIGHLIGHT_REWARD=

# Number of recent messages to include as context for Jev
JEV_CONTEXT_MESSAGES=3

# Comma-separated list of usernames to exclude from classification (e.g. mods, bots)
JEV_EXCLUDED_USERS=

# Classification thresholds (0.0 - 1.0)
# Use > 1 to disable a category (e.g. 1.1 = disabled, never flagged)
JEV_THRESHOLD_INSULT=0.7
JEV_THRESHOLD_SPAM=0.7
JEV_THRESHOLD_TOXICITY=0.7
JEV_THRESHOLD_LINKS=0.7
JEV_THRESHOLD_ATTENTION=0.7
