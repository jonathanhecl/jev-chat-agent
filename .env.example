# Twitch
TWITCH_CHANNEL=your_channel
TWITCH_USERNAME=your_bot_username
TWITCH_TOKEN=oauth:your_token_here

# Jev endpoint
JEV_ENDPOINT=http://localhost:8765/v1/systemone

# Moderation mode: false = log only, true = delete messages and time out
MODERATION_ENABLED=false

# Send chat messages when something is flagged (e.g. "@nick spam 70%")
CHAT_MESSAGES_ENABLED=false

# Number of recent messages to include as context for Jev
JEV_CONTEXT_MESSAGES=3

# Comma-separated list of usernames to exclude from classification (e.g. mods, bots)
JEV_EXCLUDED_USERS=

# Classification thresholds (0.0 - 1.0)
# Use > 1 to disable a category (e.g. 1.1 = disabled, never flagged)
JEV_THRESHOLD_INSULT=0.7
JEV_THRESHOLD_SPAM=0.7
JEV_THRESHOLD_TOXICITY=0.7
JEV_THRESHOLD_LINKS=0.7
JEV_THRESHOLD_ATTENTION=0.7
